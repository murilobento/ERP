generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stockMovements       StockMovement[]
  stockAdjustments     StockAdjustment[]   @relation("StockAdjustmentAuthor")
  completedAdjustments StockAdjustment[]   @relation("StockAdjustmentCompletedBy")
  reversedAdjustments  StockAdjustment[]   @relation("StockAdjustmentReversedBy")
}

model Company {
  id           String   @id @default(cuid())
  singletonKey String   @unique @default("default")
  name         String
  tradeName    String   @default("")
  cnpj         String   @default("")
  email        String   @default("")
  phone        String   @default("")
  logoUrl      String   @default("")
  zipCode      String   @default("")
  street       String   @default("")
  number       String   @default("")
  complement   String   @default("")
  neighborhood String   @default("")
  city         String   @default("")
  state        String   @default("")
  website      String   @default("")
  instagram    String   @default("")
  facebook     String   @default("")
  linkedin     String   @default("")
  whatsapp     String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Client {
  id           String   @id @default(cuid())
  name         String
  phone        String
  zipCode      String   @default("")
  street       String   @default("")
  number       String   @default("")
  complement   String   @default("")
  neighborhood String   @default("")
  city         String   @default("")
  state        String   @default("")
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sales Sale[]
}

model Vendor {
  id           String   @id @default(cuid())
  name         String
  phone        String
  zipCode      String   @default("")
  street       String   @default("")
  number       String   @default("")
  complement   String   @default("")
  neighborhood String   @default("")
  city         String   @default("")
  state        String   @default("")
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  purchases Purchase[]
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  unit        String   @default("un")
  margin      Float    @default(0)
  status      String   @default("active")
  categoryId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category        Category           @relation(fields: [categoryId], references: [id])
  composition     ProductComposition[]
  productions     Production[]
  productionItems ProductionItem[]
  stockMovements  StockMovement[]
  saleItems        SaleItem[]
  stockAdjustments StockAdjustment[]
}

model Supply {
  id              String   @id @default(cuid())
  name            String
  description     String   @default("")
  unit            String   @default("un")
  packageUnit     String   @default("")
  packageQuantity Float    @default(1)
  costPrice       Float    @default(0)
  status          String   @default("active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  compositions     ProductComposition[]
  stockMovements   StockMovement[]
  purchaseItems    PurchaseItem[]
  stockAdjustments StockAdjustment[]
}

model ProductComposition {
  id        String @id @default(cuid())
  productId String
  supplyId  String
  quantity  Float

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  supply  Supply  @relation(fields: [supplyId], references: [id], onDelete: Cascade)

  @@unique([productId, supplyId])
}

model Production {
  id             String    @id @default(cuid())
  productId      String
  quantity       Float
  status         String    @default("draft")
  notes          String    @default("")
  reversalReason String    @default("")
  reversedBy     String?
  reversedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  completedAt    DateTime?

  product Product          @relation(fields: [productId], references: [id])
  items   ProductionItem[]
}

model ProductionItem {
  id           String @id @default(cuid())
  productionId String
  productId    String
  quantity     Float

  production Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id])

  @@unique([productionId, productId])
}

model Purchase {
  id             String    @id @default(cuid())
  vendorId       String?
  supplier       String
  status         String    @default("pending")
  notes          String    @default("")
  reversalReason String    @default("")
  reversedBy     String?
  reversedAt     DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  items  PurchaseItem[]
  vendor Vendor?        @relation(fields: [vendorId], references: [id], onDelete: SetNull)
}

model PurchaseItem {
  id          String @id @default(cuid())
  purchaseId  String
  supplyId    String
  packages    Float
  quantity    Float
  packageCost Float  @default(0)

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  supply   Supply   @relation(fields: [supplyId], references: [id])
}

model Sale {
  id             String    @id @default(cuid())
  clientId       String
  customer       String
  status         String    @default("in_preparation")
  notes          String    @default("")
  paymentMethod  String    @default("")
  paidAt         DateTime?
  paymentNotes   String    @default("")
  reversalReason String    @default("")
  reversedBy     String?
  reversedAt     DateTime?
  deliveredAt    DateTime?
  deliveryDate   DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  client Client     @relation(fields: [clientId], references: [id])
  items  SaleItem[]
}

model SaleItem {
  id        String @id @default(cuid())
  saleId    String
  productId String
  quantity  Float
  unitPrice Float  @default(0)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([saleId, productId])
}

model StockMovement {
  id          String   @id @default(cuid())
  productId   String?
  supplyId    String?
  authorId    String?
  quantity    Float
  stockBefore Float?
  stockAfter  Float?
  type        String
  referenceId String?
  notes       String   @default("")
  createdAt   DateTime @default(now())

  product Product? @relation(fields: [productId], references: [id])
  supply  Supply?  @relation(fields: [supplyId], references: [id])
  author  User?    @relation(fields: [authorId], references: [id])
}

model StockAdjustment {
  id             String    @id @default(cuid())
  status         String    @default("pending")
  itemType       String
  productId      String?
  supplyId       String?
  quantity       Float
  reason         String    @default("")
  authorId       String
  completedById  String?
  completedAt    DateTime?
  reversedById   String?
  reversedAt     DateTime?
  reversalReason String    @default("")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  product     Product?  @relation(fields: [productId], references: [id])
  supply      Supply?   @relation(fields: [supplyId], references: [id])
  author      User      @relation("StockAdjustmentAuthor", fields: [authorId], references: [id])
  completedBy User?     @relation("StockAdjustmentCompletedBy", fields: [completedById], references: [id])
  reversedBy  User?     @relation("StockAdjustmentReversedBy", fields: [reversedById], references: [id])
}
