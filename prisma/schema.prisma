generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stockMovements StockMovement[]
}

model Client {
  id           String   @id @default(cuid())
  name         String
  phone        String
  zipCode      String   @default("")
  street       String   @default("")
  number       String   @default("")
  complement   String   @default("")
  neighborhood String   @default("")
  city         String   @default("")
  state        String   @default("")
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Vendor {
  id           String   @id @default(cuid())
  name         String
  phone        String
  zipCode      String   @default("")
  street       String   @default("")
  number       String   @default("")
  complement   String   @default("")
  neighborhood String   @default("")
  city         String   @default("")
  state        String   @default("")
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  purchases Purchase[]
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  unit        String   @default("un")
  margin      Float    @default(0)
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  composition     ProductComposition[]
  productions     Production[]
  productionItems ProductionItem[]
  stockMovements  StockMovement[]
}

model Supply {
  id              String   @id @default(cuid())
  name            String
  description     String   @default("")
  unit            String   @default("un")
  packageUnit     String   @default("")
  packageQuantity Float    @default(1)
  costPrice       Float    @default(0)
  status          String   @default("active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  compositions   ProductComposition[]
  stockMovements StockMovement[]
  purchaseItems  PurchaseItem[]
}

model ProductComposition {
  id        String @id @default(cuid())
  productId String
  supplyId  String
  quantity  Float

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  supply  Supply  @relation(fields: [supplyId], references: [id], onDelete: Cascade)

  @@unique([productId, supplyId])
}

model Production {
  id             String    @id @default(cuid())
  productId      String
  quantity       Float
  status         String    @default("draft")
  notes          String    @default("")
  reversalReason String    @default("")
  reversedBy     String?
  reversedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  completedAt    DateTime?

  product Product          @relation(fields: [productId], references: [id])
  items   ProductionItem[]
}

model ProductionItem {
  id           String @id @default(cuid())
  productionId String
  productId    String
  quantity     Float

  production Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id])

  @@unique([productionId, productId])
}

model Purchase {
  id             String    @id @default(cuid())
  vendorId       String?
  supplier       String
  status         String    @default("pending")
  notes          String    @default("")
  reversalReason String    @default("")
  reversedBy     String?
  reversedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  items  PurchaseItem[]
  vendor Vendor?        @relation(fields: [vendorId], references: [id], onDelete: SetNull)
}

model PurchaseItem {
  id          String @id @default(cuid())
  purchaseId  String
  supplyId    String
  packages    Float
  quantity    Float
  packageCost Float  @default(0)

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  supply   Supply   @relation(fields: [supplyId], references: [id])
}

model StockMovement {
  id          String   @id @default(cuid())
  productId   String?
  supplyId    String?
  authorId    String?
  quantity    Float
  stockBefore Float?
  stockAfter  Float?
  type        String
  referenceId String?
  notes       String   @default("")
  createdAt   DateTime @default(now())

  product Product? @relation(fields: [productId], references: [id])
  supply  Supply?  @relation(fields: [supplyId], references: [id])
  author  User?    @relation(fields: [authorId], references: [id])
}
