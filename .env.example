# Pooled connection string (Neon/Supabase pooler, Prisma Accelerate, etc.)
DATABASE_URL=

# Direct (non-pooled) connection for prisma migrate / introspect.
# On local single Postgres, set the same value as DATABASE_URL.
DIRECT_URL=

# Required in production (JWT signing).
JWT_SECRET=

# Comma-separated allowed origins for CORS.
# Same-origin Vercel deploy can use the production URL, e.g.:
# https://your-app.vercel.app
CORS_ORIGIN=http://localhost:5173

# Optional local seed overrides (bun run seed:admin)
# SEED_ADMIN_EMAIL=admin@admin.com
# SEED_ADMIN_PASSWORD=admin123
# SEED_ADMIN_FIRST_NAME=Admin
# SEED_ADMIN_LAST_NAME=Sistema
